#!/usr/bin/env bash
set -euo pipefail
shopt -s extglob

# --------------------------------------------------------------------------------------------------
# Install the plaintext files/directories tracked in a nix-weave filesPackage.
#
# Usage:
#   ./install STORE_PATH NIX_PATH
# Example:
#   ./install /nix/store/apzmd7w7kl9nhx66sxiagn9dv09v01m8-files /nix
# --------------------------------------------------------------------------------------------------
pkg="$(realpath "$1")"                  # the /nix/store path with all the files that need installed
dst="$(realpath "$2")"                  # destination directory for tracking e.g. /nix
files="$dst/files"                      # link to current files store path
owned_log="$dst/files.owned"            # track all the owned files
owned_tmp="$dst/files.owned.tmp"
unowned_log="$dst/files.unowned"        # track all the unowned files
unowned_tmp="$dst/files.unowned.tmp"
lock="$dst/files.lock"                  # don't do anything if the lock file exists
debug=false

log() {
  if [[ "$debug" == true ]]; then
    echo "$1"
  else
    echo -n "."
  fi
}

# Resolve an owner literal that may be a "@secret:<path>" sentinel referencing a value
# sops-nix decrypted at activation time, rather than a literal user/group name.
resolve_owner() {
  case "$1" in
    @secret:*) cat "${1#@secret:}" ;;
    *)         printf '%s' "$1" ;;
  esac
}

# Look a username up in the passwd database and print its home directory. Deliberately reads
# /etc/passwd with the shell rather than shelling out to getent, so this depends on nothing
# beyond what the activation script already has.
passwd_home() {
  local _want="$1" _name _home
  while IFS=: read -r _name _ _ _ _ _home _; do
    if [[ "$_name" == "$_want" ]]; then
      printf '%s' "$_home"
      return 0
    fi
  done < /etc/passwd
  return 1
}

# Rewrite a "@secret-user/<entry>/<relative path>" placeholder destination (emitted by
# collect.nix for files.user/files.all entries aimed at a secret.users account) into the real
# "<home>/<relative path>". The account's name comes from the same @secret: sentinel the owner
# fields already carry, so nothing here needs to know how users-from-secret.nix names its own
# internal secrets. Prints the destination unchanged when it isn't a placeholder; fails when the
# account has no resolvable home, so the caller can skip the entry rather than installing into
# a bogus path.
expand_target() {
  local _target="$1"
  case "$_target" in
    /@secret-user/*)
      local _rest _owner _home
      _rest="${_target#/@secret-user/}"      # <entry>/<relative path>
      _rest="${_rest#*/}"                    # <relative path>
      _owner="$(resolve_owner "$user")"
      [[ -n "$_owner" ]] || return 1
      _home="$(passwd_home "$_owner")" || return 1
      [[ -n "$_home" ]] || return 1
      printf '%s/%s' "$_home" "$_rest"
      ;;
    *)
      printf '%s' "$_target"
      ;;
  esac
}

# Clean up any files left over from the previous install
clean() {
  readarray -t owned_new < "$owned_log"
  readarray -t unowned_new < "$unowned_log"

  for x in "${owned_old[@]}"; do
    local _exists=false
    for y in "${owned_new[@]}"; do
      if [[ "$x" == "$y" ]]; then
        _exists=true
        break
      fi
    done

    if [[ "$_exists" != true ]]; then
      for y in "${unowned_new[@]}"; do
        if [[ "$x" == "$y" ]]; then
          _exists=true
          break
        fi
      done
    fi

    if [[ "$_exists" != true ]]; then
      log " removing: $x"
      if [[ -d "$x" ]]; then
        rm -rf "$x"
      else
        rm -f "$x"
      fi
    fi
  done
}

# Read the metadata for the file and/or directory being processed
metadata() {
  local _metafile="${1}"
  readarray -t meta < "$_metafile"
  kind="${meta[0]}"        # kind of object [ copy, link ]
  src="${meta[1]}"         # nix store path of the object
  dirmode="${meta[2]}"     # mode for any directories needing created
  filemode="${meta[3]}"    # mode for any files needing created
  user="${meta[4]}"        # owner (literal or @secret:<path>)
  group="${meta[5]}"       # group (literal or @secret:<path>)
  own="${meta[6]}"         # whether to own the file or directory [ owned | unowned ]
}

# Create missing directories with the given metadata in dirmode, user, group
mkdir_p() {
  local _dir="$1"
  if [[ -d "$_dir" ]]; then
    return
  else
    mkdir_p "$(dirname "$_dir")"
  fi

  log "    mkdir: $_dir"
  mkdir -m "$dirmode" "$_dir"
  chown "$(resolve_owner "$user")":"$(resolve_owner "$group")" "$_dir"
}

# Copy the given source store path to the destination target system path.
# Only copies if the file doesn't exist yet, is owned, or was never previously recorded.
copy() {
  local _src="${1}" _target="${2}"

  local _copy=false
  if [[ "$own" == "owned" || ! -f "$_target" ]]; then
    _copy=true
  else
    local _exists=false
    for x in "${unowned_old[@]}"; do
      if [[ "$x" == "$_target" ]]; then
        _exists=true
        break
      fi
    done
    [[ "$_exists" == false ]] && _copy=true
  fi

  if [[ "$_copy" == true ]]; then
    log "  copying: $_src -> $_target"
    install -C -m "$filemode" -o "$(resolve_owner "$user")" -g "$(resolve_owner "$group")" "$_src" "$_target"
  fi
}

# Link the given source store path to the target via the /nix/files indirection
link() {
  local _src="${1}" _inter="${2}" _target="${3}"
  local _user _group
  _user="$(resolve_owner "$user")"
  _group="$(resolve_owner "$group")"

  if [[ ! -e "$_target" ]]; then
    log "  linking: $_target -> $_inter -> $_src"
    ln -sf "$_inter" "$_target"
    chown -h "$_user":"$_group" "$_target"
  elif [[ "$(realpath "$_target")" != "$_src" ]]; then
    log " updating: $_target -> $_inter -> $_src"
    # $_target may be a real directory rather than a stale symlink/file - e.g. an app that has
    # already run once and populated its config dir before this link was ever managed. Plain
    # `rm -f` refuses to remove a directory ("Is a directory"), so use -r to cover both cases.
    rm -rf "$_target"
    ln -sf "$_inter" "$_target"
    chown -h "$_user":"$_group" "$_target"
  fi
}

# Create the file or link
# - $3 is the entry's path *inside* the files package, which is only the same as $2 for a
#   non-placeholder destination. The /nix/files indirection has to be built from the package-
#   relative path, not the expanded one: expand_target rewrites a "/@secret-user/<entry>/..."
#   destination to the account's real home, but the package still lays the content out under
#   the placeholder, so deriving _inter from $2 yields a symlink into /nix/files/home/<user>/...
#   which does not exist -- every link entry for a secret.users account lands broken.
mkfile() {
  local _src="${1}" _target="${2}" _pkgpath="${3:-$2}"

  mkdir_p "$(dirname "$_target")"

  if [[ "$kind" == "copy" ]]; then
    copy "$_src" "$_target"
  elif [[ "$kind" == "link" ]]; then
    local _inter="${files}${_pkgpath}"
    link "$_src" "$_inter" "$_target"
  fi

  if [[ "$own" == "owned" || "$kind" == "link" ]]; then
    echo "$_target" >> "$owned_log"
  else
    echo "$_target" >> "$unowned_log"
  fi
}

# Loop through single files
mkfiles() {
  local _relpath _expanded _target
  find "$pkg" -name "*.meta.file" | while read -r x; do
    metadata "$x"
    _relpath="${x#"$pkg"}"
    _relpath="${_relpath%".meta.file"}"
    if ! _target="$(expand_target "$_relpath")"; then
      log " skipping: $_relpath (no home directory resolved for its secret.users account)"
      continue
    fi
    mkfile "$src" "$_target" "$_relpath"
  done
}

# Loop through directories, installing every file they contain
mkdirs() {
  local _relpath _expanded _suffix
  find "$pkg" -name "*.meta.dir" | while read -r x; do
    metadata "$x"
    _relpath="${x#"$pkg"}"
    _relpath="${_relpath%".meta.dir"}"
    if ! _expanded="$(expand_target "$_relpath")"; then
      log " skipping: $_relpath (no home directory resolved for its secret.users account)"
      continue
    fi
    mkdir_p "$_expanded"

    # _relpath stays the package-relative path here so mkfile can build the /nix/files
    # indirection from it; only the destination gets the expanded home.
    find "$src" -type f | while read -r y; do
      _suffix="${y#"$src"}"
      mkfile "$y" "${_expanded}${_suffix}" "${_relpath}${_suffix}"
    done
  done
}

# Install files
# --------------------------------------------------------------------------------------------------
[[ -f "$lock" ]] && exit
echo "installing files from ${pkg}"

[[ ! -f "$owned_log" ]] && touch "$owned_log"
[[ ! -f "$unowned_log" ]] && touch "$unowned_log"
mv "$owned_log" "$owned_tmp" && touch "$owned_log"
mv "$unowned_log" "$unowned_tmp" && touch "$unowned_log"
readarray -t owned_old < "$owned_tmp"
readarray -t unowned_old < "$unowned_tmp"

if [[ ! -d "$files" ]]; then
  ln -sf "$pkg" "$files"
elif [[ "$(realpath "$files")" != "$pkg" ]]; then
  rm -f "$files"
  ln -sf "$pkg" "$files"
fi

mkdirs
mkfiles
clean

# vim: ts=2:sw=2:sts=2
